<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="15dp"
    android:paddingTop="12dp"
    android:paddingEnd="15dp"
    android:paddingBottom="10dp"
    android:background="@drawable/medication_widget_background">

    <!-- 상단 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="78dp"
            android:layout_height="25dp"
            android:scaleType="fitStart"
            android:src="@drawable/soomit_widget_logo"
            android:contentDescription="숨-잇 로고" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:text="" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="오늘의 복약"
            android:textColor="#7F8B97"
            android:textSize="10sp" />

    </LinearLayout>

    <!-- 상태 -->
    <TextView
        android:id="@+id/widgetStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="●  복약 예정"
        android:textColor="#3478F6"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- 약 이름 -->
    <TextView
        android:id="@+id/widgetMedicationName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Osimertinib 80mg"
        android:textColor="#202A35"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- 예정 시간 -->
    <TextView
        android:id="@+id/widgetMedicationTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="01:20"
        android:textColor="#3478F6"
        android:textSize="25sp"
        android:textStyle="bold" />

    <!-- 완료/미복용 보조문구 -->
    <TextView
        android:id="@+id/widgetMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="01:20 일정 복용을 완료했어요"
        android:textColor="#5F6C79"
        android:textSize="10sp"
        android:visibility="gone" />

    <!-- 고정 여백 -->
    <TextView
        android:layout_width="1dp"
        android:layout_height="10dp"
        android:text="" />

    <!-- 진행률 -->
    <TextView
        android:id="@+id/widgetProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="오늘 1/1회 복용"
        android:textColor="#8995A1"
        android:textSize="10sp" />

    <!-- Kotlin 호환용, 항상 숨김 -->
    <TextView
        android:id="@+id/widgetProgressPercent"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:text=""
        android:visibility="gone" />

    <!-- 진행바 -->
    <ProgressBar
        android:id="@+id/widgetProgressBar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="7dp"
        android:layout_marginEnd="8dp"
        android:max="100"
        android:progress="0"
        android:indeterminate="false"
        android:progressTint="#3478F6"
        android:progressBackgroundTint="#E8EEF5" />
</LinearLayout>