# ai-services/embedding. Deployed on Cloud Run (CPU); the backend's service
# account (sumit-gcs-sa@soomit-506909.iam.gserviceaccount.com) has roles/run.invoker
# on it. Set EMBEDDING_SERVICE_USE_ID_TOKEN=0 only if you point this at a local
# unauthenticated uvicorn instead.
EMBEDDING_SERVICE_URL=https://embedding-serve-461462459694.asia-southeast1.run.app
EMBEDDING_SERVICE_TIMEOUT_SECONDS=30
EMBEDDING_SERVICE_USE_ID_TOKEN=1

# ai-services/medgemma. Deployed on Cloud Run (GPU); the backend's service
# account (sumit-gcs-sa@soomit-506909.iam.gserviceaccount.com) has roles/run.invoker
# on it, so this stays on with a real ID token unless you point this at a local
# uvicorn instead.
MEDGEMMA_SERVICE_URL=https://medgemma-serve-461462459694.asia-southeast1.run.app
# Cloud Run GPU cold starts can take 2+ minutes; the revision's own request
# timeout is 300s, so stay just under that.
MEDGEMMA_SERVICE_TIMEOUT_SECONDS=290
MEDGEMMA_SERVICE_USE_ID_TOKEN=1
