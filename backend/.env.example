# Local Django development only. VM Docker uses infra/.env independently.
# Connect to the existing VM PostgreSQL; no DB is created by infra.
POSTGRES_DB=example-db
POSTGRES_USER=example-db-user
POSTGRES_PASSWORD=change-in-deployment
POSTGRES_HOST=YOUR_VM_INTERNAL_DB_ADDRESS
POSTGRES_PORT=5432

DJANGO_SECRET_KEY=change-in-deployment
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# Internal PD-L1 AMD-MIL feature inference service
PDL1_INFERENCE_SERVICE_URL=http://127.0.0.1:8100
PDL1_INFERENCE_TIMEOUT_SECONDS=60
PDL1_FEATURE_MAX_UPLOAD_BYTES=67108864

# Shared VM Orthanc: use the VM endpoint or a local SSH tunnel.
# Match ORTHANC_USERNAME / ORTHANC_PASSWORD to infra/.env on the VM.
ORTHANC_BASE_URL=http://127.0.0.1:8042
ORTHANC_USERNAME=example-orthanc-user
ORTHANC_PASSWORD=change-in-deployment
ORTHANC_TIMEOUT_SECONDS=30

# Host processes use VM loopback; Compose overrides these with redis service DNS.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
