FROM python:3.10-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    MODEL_REVISION=ct-analysis-v1.0.0 \
    CT_ANALYSIS_OUTPUT_GCS_PREFIX=gs://soomit-bucket/ct-analysis

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-phase2.txt .
RUN pip install --no-cache-dir numpy==1.24.4 \
    && pip install --no-cache-dir --no-build-isolation -r requirements-phase2.txt

COPY storage_io.py phase2_server.py ./
COPY packages/final_ct_analysis_deploy_ready ./packages/final_ct_analysis_deploy_ready
COPY packages/final_n_input_deploy_ready ./packages/final_n_input_deploy_ready

RUN useradd --create-home --uid 10001 app && chown -R app:app /app
USER app

EXPOSE 8080
CMD ["sh", "-c", "exec python -m uvicorn phase2_server:app --host 0.0.0.0 --port ${PORT:-8080} --workers 1 --no-access-log"]
