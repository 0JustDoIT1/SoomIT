# VM Docker configuration. Placeholders pass config parsing, not deployment checks.
# Required: replace example values before deployment.
# Existing VM PostgreSQL address reachable FROM containers (not localhost).
POSTGRES_HOST=YOUR_VM_INTERNAL_DB_ADDRESS
POSTGRES_PORT=5432
POSTGRES_DB=example-db
POSTGRES_USER=example-db-user
POSTGRES_PASSWORD=change-in-deployment
DJANGO_SECRET_KEY=change-in-deployment

# Values are interpolated into JSON: avoid double quotes, backslashes and newlines.
# A long random hexadecimal password avoids JSON and dotenv escaping issues.
ORTHANC_USERNAME=example-orthanc-user
ORTHANC_PASSWORD=change-in-deployment
ORTHANC_TIMEOUT_SECONDS=30
ORTHANC_PUBLIC_URL=http://example.invalid/orthanc/

# Optional defaults: POSTGRES_PORT=5432, ORTHANC_TIMEOUT_SECONDS=30.
# Default: host access and SSH tunnels only. Configure each port independently.
# For direct access, use a VM interface address and restrict source IPs in GCP.
ORTHANC_HTTP_BIND_ADDRESS=127.0.0.1
ORTHANC_DICOM_BIND_ADDRESS=127.0.0.1
